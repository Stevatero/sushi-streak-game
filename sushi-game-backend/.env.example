# Copia questo file in .env (non versionato) oppure imposta le variabili in PM2/systemd.
# Tutte le variabili sono facoltative: i valori sotto sono i default.

NODE_ENV=production
PORT=3000
# Interfaccia di ascolto (in produzione dietro nginx: 127.0.0.1)
HOST=0.0.0.0
# DB_PATH=/var/lib/sushi-streak/sushi_game.db
SESSION_INACTIVITY_MIN=180
SESSION_RETENTION_DAYS=30
# Origini web ammesse (CORS), separate da virgola
# CORS_ORIGINS=https://sushi.dietalab.net
TRUST_PROXY=loopback
LOG_LEVEL=info
# Impronte SHA-256 del certificato di firma Play (App signing key), separate da virgola.
# Abilitano /.well-known/assetlinks.json per la verifica degli Android App Links.
# ANDROID_CERT_SHA256=AA:BB:CC:...
# ANDROID_PACKAGE=com.stevatero.sushistreakapp
# Pagina da cui scaricare l'app, usata dalla pagina di invito se l'app non è installata.
# Default: scheda Google Play di ANDROID_PACKAGE.
# APP_STORE_URL=https://play.google.com/store/apps/details?id=com.stevatero.sushistreakapp
# iOS: Team ID dell'account Apple Developer (10 caratteri, developer.apple.com → Membership).
# Abilita /.well-known/apple-app-site-association per gli Universal Links.
# APPLE_TEAM_ID=ABCDE12345
# IOS_BUNDLE_ID=com.stevatero.sushistreakapp
# Pagina dell'app sull'App Store: link di download su iPhone e Smart App Banner nella pagina di invito.
# Lasciare vuota finché l'app iOS non è pubblicata.
# IOS_APP_STORE_URL=https://apps.apple.com/it/app/sushi-streak/id0000000000
# Contatto mostrato nella pagina /privacy (email o URL). Default: issue GitHub del progetto.
# PRIVACY_CONTACT=privacy@example.com
