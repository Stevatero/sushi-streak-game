{
  "name": "sushi-streak-backend",
  "version": "1.4.1",
  "private": true,
  "description": "Backend real-time di Sushi Streak: API REST, Socket.IO, SQLite e pagine web di invito e privacy",
  "main": "server.js",
  "keywords": [
    "sushi",
    "game",
    "socket.io",
    "express",
    "real-time",
    "multiplayer",
    "sqlite"
  ],
  "author": {
    "name": "Dario Stevanato",
    "url": "https://github.com/Stevatero"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stevatero/sushi-streak-game.git",
    "directory": "sushi-game-backend"
  },
  "bugs": {
    "url": "https://github.com/Stevatero/sushi-streak-game/issues"
  },
  "homepage": "https://github.com/Stevatero/sushi-streak-game#readme",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "backup": "node scripts/backup.js",
    "prod": "pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop sushi-streak-backend",
    "restart": "pm2 restart sushi-streak-backend",
    "logs": "pm2 logs sushi-streak-backend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4"
  }
}
