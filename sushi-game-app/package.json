{
  "name": "sushi-streak-app",
  "version": "1.2.0",
  "private": true,
  "description": "App mobile per tenere traccia di chi mangia più sushi durante una cena con gli amici, con classifica in tempo reale.",
  "main": "index.ts",
  "keywords": [
    "react-native",
    "expo",
    "sushi",
    "game",
    "real-time",
    "socket.io",
    "multiplayer",
    "android",
    "typescript"
  ],
  "author": {
    "name": "Dario Stevanato",
    "url": "https://github.com/Stevatero"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stevatero/sushi-streak-game.git",
    "directory": "sushi-game-app"
  },
  "bugs": {
    "url": "https://github.com/Stevatero/sushi-streak-game/issues"
  },
  "homepage": "https://github.com/Stevatero/sushi-streak-game#readme",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "clean": "expo start -c",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "doctor": "expo-doctor",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "export:android": "expo export --platform android --output-dir dist",
    "build:dev": "eas build -p android --profile development",
    "build:preview": "eas build -p android --profile preview",
    "build:production": "eas build -p android --profile production",
    "build:production:apk": "eas build -p android --profile production-apk",
    "submit:production": "eas submit -p android --profile production --latest",
    "eas-build-pre-install": "node scripts/configure-build-variant.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/android/",
      "/ios/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/types/**"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/joti-one": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@types/jest": "29.5.14",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "semver": "^7.8.5",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
